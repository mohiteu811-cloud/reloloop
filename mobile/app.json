{
  "expo": {
    "name": "LivinLoop",
    "slug": "livinloop",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "livinloop",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.livinloop.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.livinloop.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LivinLoop to use the camera to capture photos of items you want to swap."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://app.livinloop.com"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
