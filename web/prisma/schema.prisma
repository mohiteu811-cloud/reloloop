// LivinLoop schema. Source of truth: reloloop-schema.md §2.2.
// Keep this file in sync with the schema doc.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, vector]
}

// ============================================================
// AUTH — Auth.js v5 wants these tables present
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  phone         String?

  city   City?   @relation("UserHomeCity", fields: [cityId], references: [id])
  cityId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moves          Move[]
  listings       Listing[]
  proposalsSent  SwapProposal[]            @relation("ProposalFromUser")
  proposalsRecvd SwapProposal[]            @relation("ProposalToUser")
  conversations  ConversationParticipant[]
  messages       Message[]
  feePayments    FeePayment[]

  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// GEOGRAPHY
// ============================================================

model City {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  country String  @default("NZ")
  lat     Float
  lng     Float
  active  Boolean @default(true)

  users          User[]    @relation("UserHomeCity")
  listingsOrigin Listing[] @relation("ListingOriginCity")
  listingsWanted Listing[] @relation("ListingWantedCity")
  movesFrom      Move[]    @relation("MoveFromCity")
  movesTo        Move[]    @relation("MoveToCity")

  @@index([slug])
}

// ============================================================
// MOVE
// ============================================================

model Move {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromCityId String
  fromCity   City   @relation("MoveFromCity", fields: [fromCityId], references: [id])
  toCityId   String
  toCity     City   @relation("MoveToCity", fields: [toCityId], references: [id])

  moveDate        DateTime
  flexibilityDays Int      @default(7)

  status MoveStatus @default(PLANNING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([toCityId, moveDate])
  @@index([userId, status])
}

enum MoveStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

// ============================================================
// CATEGORY
// ============================================================

model ItemCategory {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  matchToleranceBps Int @default(2000)
  depreciationCurve Json

  listings Listing[]

  @@index([slug])
}

// ============================================================
// LISTING — two-sided by design
// ============================================================

enum Condition {
  LIKE_NEW
  GOOD
  USED
  WORN
}

enum ListingStatus {
  DRAFT
  PROCESSING
  LIVE
  PROPOSED
  LOCKED
  SWAPPED
  WITHDRAWN
}

model Listing {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId  String
  category    ItemCategory @relation(fields: [categoryId], references: [id])
  title       String
  description String?      @db.Text

  brand     String?
  model     String?
  ageYears  Float?
  condition Condition

  widthCm  Int?
  depthCm  Int?
  heightCm Int?
  weightKg Float?

  originalRetailCents  Int?
  estimatedValueCents  Int?
  askingValueCents     Int
  askingValueRationale String? @db.Text
  valuationBreakdown   Json?

  // AI-noticed defects from listing-autofill. Surfaced on the
  // review screen as a separate "AI noticed" section so the user
  // can decide whether to mention them in the description, but
  // NOT auto-merged into title/description. Empty array when no
  // extraction has run or the AI saw nothing wrong.
  visibleDefects String[] @default([])

  originCityId String
  originCity   City   @relation("ListingOriginCity", fields: [originCityId], references: [id])
  wantedCityId String
  wantedCity   City   @relation("ListingWantedCity", fields: [wantedCityId], references: [id])

  availableUntil DateTime
  wantedNotes    String?  @db.Text

  status      ListingStatus @default(DRAFT)
  publishedAt DateTime?
  swappedAt   DateTime?

  photos       Photo[]
  embedding    ListingEmbedding?
  proposalsAsA SwapProposal[]    @relation("ProposalListingA")
  proposalsAsB SwapProposal[]    @relation("ProposalListingB")
  matchesAsA   SwapMatch[]       @relation("MatchListingA")
  matchesAsB   SwapMatch[]       @relation("MatchListingB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, status, originCityId, wantedCityId, askingValueCents])
  @@index([userId, status])
  @@index([status, publishedAt])
}

// ============================================================
// PHOTO
// ============================================================

model Photo {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  r2Key          String
  url            String
  thumbUrl       String?
  width          Int?
  height         Int?
  bytes          Int?
  perceptualHash String?
  sortOrder      Int     @default(0)

  uploadedAt DateTime @default(now())

  @@unique([listingId, r2Key])
  @@index([listingId])
}

// ============================================================
// EMBEDDING
// ============================================================

model ListingEmbedding {
  listingId String  @id
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  vector Unsupported("vector(768)")

  modelName    String
  modelVersion String

  computedAt DateTime @default(now())
}

// ============================================================
// SWAP MATCH
// ============================================================

model SwapMatch {
  id String @id @default(cuid())

  listingAId String
  listingA   Listing @relation("MatchListingA", fields: [listingAId], references: [id], onDelete: Cascade)
  listingBId String
  listingB   Listing @relation("MatchListingB", fields: [listingBId], references: [id], onDelete: Cascade)

  semanticScore  Float
  valueScore     Float
  geographyScore Float
  overallScore   Float

  computedAt DateTime @default(now())

  @@unique([listingAId, listingBId])
  @@index([listingAId, overallScore])
  @@index([listingBId, overallScore])
}

// ============================================================
// SWAP PROPOSAL
// ============================================================

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
  CANCELLED
}

model SwapProposal {
  id String @id @default(cuid())

  fromUserId String
  fromUser   User   @relation("ProposalFromUser", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User   @relation("ProposalToUser", fields: [toUserId], references: [id])

  listingAId String
  listingA   Listing @relation("ProposalListingA", fields: [listingAId], references: [id])
  listingBId String
  listingB   Listing @relation("ProposalListingB", fields: [listingBId], references: [id])

  message String? @db.Text

  status        ProposalStatus @default(PENDING)
  expiresAt     DateTime
  respondedAt   DateTime?
  declineReason String?

  conversation Conversation?
  fee          SwapFee?

  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([listingAId])
  @@index([listingBId])
}

// ============================================================
// SWAP FEE
// ============================================================

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  FAILED
}

model SwapFee {
  id String @id @default(cuid())

  proposalId String       @unique
  proposal   SwapProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  swapValueCents   Int
  feeBps           Int @default(100)
  totalFeeCents    Int
  perPartyFeeCents Int

  status     FeeStatus @default(PENDING)
  paidAt     DateTime?
  refundedAt DateTime?

  payments FeePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum FeePaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model FeePayment {
  id String @id @default(cuid())

  feeId String
  fee   SwapFee @relation(fields: [feeId], references: [id], onDelete: Cascade)

  payerId String
  payer   User   @relation(fields: [payerId], references: [id])

  amountCents Int
  currency    String @default("NZD")

  status FeePaymentStatus @default(PENDING)

  paypalOrderId    String? @unique
  paypalCaptureId  String?
  paypalPayerEmail String?
  rawWebhookEvent  Json?

  paidAt        DateTime?
  refundedAt    DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([feeId, payerId])
  @@index([payerId, status])
  @@index([status])
}

// ============================================================
// CONVERSATION
// ============================================================

model Conversation {
  id String @id @default(cuid())

  proposalId String       @unique
  proposal   SwapProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  participants ConversationParticipant[]
  messages     Message[]

  lastMessageAt DateTime?
  contactRevealedAt DateTime?

  pickupConfirmedByA DateTime?
  pickupConfirmedByB DateTime?
  swapCompletedByA   DateTime?
  swapCompletedByB   DateTime?

  createdAt DateTime @default(now())

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])

  body        String @db.Text
  attachments Json?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}
