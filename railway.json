{
  "$schema": "https://railway.app/railway-schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfigPath": "nixpacks.toml",
    "buildCommand": "cd web && npm ci && npx prisma generate && npm run build"
  },
  "deploy": {
    "startCommand": "cd web && npm run start",
    "healthcheckPath": "/api/health"
  }
}
