# ═══════════════════════════════════════════════════════
# LivinLoop — Environment Configuration
# ═══════════════════════════════════════════════════════
# Copy this file to `web/.env` and fill in values. Both Next.js
# and the Prisma CLI auto-load `.env`, so one file covers `next
# dev`, `next build`, `prisma generate`, `prisma db push`, the
# seed script, and the BullMQ worker.
#
# NEVER commit a filled-in .env.
#
# Legend (right-margin tags):
#   [REUSE] — same vendor account as LivAround, new project/key
#   [NEW]   — net-new vendor or extension not used by LivAround
#   [LATER] — leave blank for v1; flag-gated
# ═══════════════════════════════════════════════════════

# ─── Core ──────────────────────────────────────────────────
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=replace-me

# Public app URL (used in emails, PayPal return URLs, push deep links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (Postgres + pgvector) ────────────────────────
# Railway Postgres. After provision, connect once and run:
#   CREATE EXTENSION IF NOT EXISTS pgcrypto;
#   CREATE EXTENSION IF NOT EXISTS vector;
# Prisma manages migrations; the HNSW index on ListingEmbedding
# is created via a raw SQL migration (see prisma/migrations/).
DATABASE_URL=postgresql://postgres:password@localhost:5432/livinloop   # [NEW: pgvector required]
# Optional direct URL (skip PgBouncer for prisma migrate)
# DIRECT_URL=postgresql://postgres:password@localhost:5432/livinloop

# ─── Redis (BullMQ) ────────────────────────────────────────
# Railway Redis. Required — workers run photo postprocess,
# Claude extraction, valuation, CLIP embedding, match recompute.
REDIS_URL=redis://localhost:6379                                       # [NEW]

# Optional namespace prefix if you ever share the Redis instance
BULLMQ_PREFIX=livinloop

# ─── Auth (Auth.js v5, Resend magic-link provider) ─────────
# Same Resend account as LivAround, new verified domain.
RESEND_API_KEY=re_xxxxxxxxxxxx                                         # [REUSE]
EMAIL_FROM="LivinLoop <noreply@livinloop.com>"                         # [REUSE]
EMAIL_REPLY_TO=hello@livinloop.com

# ─── Object storage (Cloudflare R2) ────────────────────────
# Same Cloudflare account as LivAround, new bucket.
R2_ACCOUNT_ID=your-cloudflare-account-id                               # [REUSE]
R2_ACCESS_KEY_ID=your-r2-access-key                                    # [REUSE]
R2_SECRET_ACCESS_KEY=your-r2-secret                                    # [REUSE]
R2_BUCKET=livinloop-photos                                             # [NEW bucket]
R2_PUBLIC_BASE_URL=https://cdn.livinloop.com

# v1 uses simple presigned PUT (carry over from LivAround).
# Set to true later if we add tus-node-server for resumable uploads.
TUS_ENABLED=false                                                      # [LATER]

# ─── AI: vision + extraction ───────────────────────────────
# v1: Claude Sonnet for item analysis (same vendor as LivAround).
# Schema calls for Gemini 2.5 Flash; we swap in later behind the
# AI_VISION_PROVIDER flag once we've tuned the prompts.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx                                  # [REUSE]
AI_VISION_PROVIDER=claude                                              # claude | gemini
AI_VISION_MODEL=claude-sonnet-4-6                                      # text+vision

# Reserved for the Gemini cutover (M3 → tune, M4 → flip).
# GOOGLE_AI_API_KEY=                                                   # [LATER]
# GEMINI_MODEL=gemini-2.5-flash

# ─── AI: embeddings (CLIP via Replicate) ───────────────────
# Replicate hosts CLIP ViT-B/32. ~$0.0005 per call at v1 volume.
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxx                                    # [NEW]
CLIP_MODEL=replicate/clip-vit-base-patch32
CLIP_VECTOR_DIM=768

# ─── Payments (PayPal Orders v2) ───────────────────────────
# Same PayPal Business merchant account as LivAround; new REST
# app under PayPal Developer Dashboard so LivinLoop has its own
# client ID + webhook. NOTE: this is Orders v2 (one-off captures),
# not the Subscriptions API LivAround uses for plan billing.
PAYPAL_MODE=sandbox                                                    # sandbox | live
PAYPAL_CLIENT_ID=your-livinloop-client-id                              # [REUSE merchant, NEW app]
PAYPAL_CLIENT_SECRET=your-livinloop-client-secret                      # [REUSE merchant, NEW app]
PAYPAL_WEBHOOK_ID=your-orders-v2-webhook-id                            # [NEW webhook]
# Subscribe webhook to:
#   PAYMENT.CAPTURE.COMPLETED
#   PAYMENT.CAPTURE.DENIED
#   PAYMENT.CAPTURE.REFUNDED

# Currency for fees (NZ-first per schema)
DEFAULT_CURRENCY=NZD

# ─── Fee model knobs (schema §5) ───────────────────────────
SWAP_FEE_BPS=100                # 1%
PROPOSAL_EXPIRY_HOURS=72
FEE_GATE_TIMEOUT_DAYS=7

# ─── Matching engine knobs (schema §4) ─────────────────────
MATCH_SCORE_THRESHOLD=0.6       # SwapMatch rows persisted above this
MATCH_RECOMPUTE_CRON="0 2 * * *"  # 02:00 NZST nightly

# ─── Mobile / Push (Expo + Firebase) ──────────────────────
# Same Expo org as LivAround, new Expo project.
EXPO_PROJECT_ID=your-expo-project-id                                   # [REUSE org]
# Server-side push: use Expo's push service initially; FCM creds
# are needed at build time on the mobile app, not here.
EXPO_ACCESS_TOKEN=your-expo-access-token                               # [REUSE]

# ─── Monitoring ────────────────────────────────────────────
# SENTRY_DSN=https://xxxx@sentry.io/xxxx                              # [REUSE org, NEW project]
# SENTRY_ENVIRONMENT=development

# ─── Admin ─────────────────────────────────────────────────
ADMIN_EMAIL=mohit@livinloop.com
SIGNUP_ALERT_EMAIL=signups@livinloop.com

# ─── Flags ─────────────────────────────────────────────────
# Toggle fee gate so M5 can ship with contact-reveal-on-accept
# for the pilot cohort while M6 builds out PayPal.
FEES_ENABLED=false
# Toggle match recompute job (default on once embeddings exist)
MATCHING_ENABLED=true
